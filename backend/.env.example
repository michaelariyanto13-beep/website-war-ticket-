PORT=4000
# Asal frontend (CORS). Saat dev Vite: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi_service_role_key   # RAHASIA: isi di backend/.env, JANGAN di file ini

# Login admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti_password_kuat
JWT_SECRET=ganti_dengan_string_acak_panjang

# Email tiket QR (opsional — tanpa ini QR tetap tampil di layar setelah daftar)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=emailkamu@gmail.com,
#        SMTP_PASS=App Password 16 huruf (bukan password Gmail biasa)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=WarLari <emailkamu@gmail.com>
